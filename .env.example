# 팀 공용 비밀번호 (실제 값은 .env.local에 넣고, 저장소에 올리지 않습니다)
TEAM_PASSWORD=

# MCP JSON 가져오기 전용 관리자 비밀번호 (팀 비밀번호와 다른 16자 이상 값).
# 미설정 시 /api/admin/mcp-import는 잠깁니다. 실제 값은 .env.local / Vercel 서버 환경변수에만 설정합니다.
MCP_IMPORT_ADMIN_PASSWORD=

# 1-1. 인덱스 생성 및 동기화 (실제 값은 .env.local과 Vercel 환경 변수에만 넣습니다)
# Figma 토큰은 여기에 넣지 않습니다. /sync 화면의 "팀 공용 Figma 토큰"에서 등록하면 위 Redis에 보관됩니다.
# 검색 인덱스 저장소 (Upstash Redis. Vercel에서 붙이면 KV_REST_API_URL / KV_REST_API_TOKEN 이름으로도 만들어집니다)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
